{
  "app_name": "AssistenteIA",
  "debug": true,
  "DEBUG_AGENT": true,
  "DEBUG_CONTEXT": true,
  "DEBUG_PERFORMANCE": true,
  "DEBUG_OLLAMA_PAYLOAD": true,
  "default_presence": "ACTIVE_CONVERSATION",
  "model": {
    "provider": "ollama",
    "name": "llama3.1:8b"
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "model": "llama3.1:8b",
    "timeout_seconds": 120
  },
  "anthropic": {
    "base_url": "https://api.anthropic.com",
    "timeout_seconds": 120,
    "max_tokens": 1024
  },
  "assistant": {
    "system_prompt": "Es o AssistenteIA, um assistente local para Windows 11. Responde em portugues de Portugal, de forma clara e util. Mantem-te seguro: nao executes comandos do sistema, nao acedas a ficheiros fora da pasta workspace e nao finjas ter capacidades que ainda nao existem nesta versao."
  },
  "workspace": {
    "path": "workspace"
  },
  "context_observer": {
    "enabled": true,
    "interval_seconds": 15,
    "recent_files_limit": 10,
    "summary_min_seconds": 60,
    "db_file": "context_observer.sqlite"
  },
  "desktop_actions": {
    "enabled": true,
    "default_browser": "chrome",
    "default_email": "gmail",
    "known_projects": {
      "assistenteIA": "C:/Users/alexm/.vscode/projects/assistenteIA"
    }
  },
  "voice": {
    "enabled": true,
    "model": "base",
    "language": "pt",
    "input_device": "default",
    "auto_select_input": true,
    "silent_rms_threshold": 0.001,
    "sample_rate": 44100,
    "channels": 1,
    "probe_duration_seconds": 0.5,
    "min_record_seconds": 2,
    "preroll_ms": 500,
    "ready_delay_ms": 200
  },
  "memory": {
    "data_path": "data",
    "history_file": "history.json",
    "long_term_db": "long_term_memory.sqlite",
    "personal_model_db": "personal_model.sqlite",
    "session_db": "session_manager.sqlite",
    "max_messages": 20
  }
}
